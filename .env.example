# Base de donnees PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/pasteur_gnali?schema=public"

# Authentification (Auth.js / NextAuth)
# Generez une valeur forte : `openssl rand -base64 32`
AUTH_SECRET="changez-moi-avec-une-valeur-aleatoire-forte"
NEXTAUTH_URL="http://localhost:3000"

# Stockage des fichiers (images et PDF)
# Par defaut (STORAGE_PROVIDER vide) :
#   1. Vercel Blob en principal, des que le jeton du store est present
#   2. S3 / Supabase en secours, si Vercel Blob refuse (store plein, suspendu...)
#   3. sans aucun des deux, en developpement : dossier /public/uploads
# Pour forcer un stockage unique : "local" ou "s3".
STORAGE_PROVIDER=""

# Vercel Blob : injecte automatiquement par Vercel en connectant le store
# (Storage > store > Connect Project). En local : `npx vercel env pull`.
# Le store doit etre PUBLIC. Un prefixe personnalise est accepte
# (ex. JMGFILE_READ_WRITE_TOKEN).
BLOB_READ_WRITE_TOKEN=""

# S3 / Supabase Storage (stockage de secours)
# Supabase : Storage > creer un bucket PUBLIC (ex. "medias")
S3_BUCKET=""
# Supabase : Project Settings > Storage > S3 Connection > Region (ex. eu-west-3)
S3_REGION=""
# Supabase : Project Settings > Storage > S3 Access Keys > New access key
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Laisser vide pour AWS S3. Supabase : https://<ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=""
# Optionnel : URL publique des fichiers si elle n'est pas deduite automatiquement
# (deduite pour Supabase ; a renseigner pour Cloudflare R2, etc.)
S3_PUBLIC_URL=""

# URL publique du site (utilisee pour le SEO, les sitemaps, les donnees structurees)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
