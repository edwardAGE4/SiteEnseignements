# Base de donnees PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/pasteur_gnali?schema=public"

# Authentification (Auth.js / NextAuth)
# Generez une valeur forte : `openssl rand -base64 32`
AUTH_SECRET="changez-moi-avec-une-valeur-aleatoire-forte"
NEXTAUTH_URL="http://localhost:3000"

# Stockage des fichiers (images et PDF)
# "s3"    -> AWS S3 ou tout service compatible S3 (Supabase Storage, etc.)
# "local" -> ecriture locale dans /public/uploads (developpement uniquement,
#            deconseille en production)
STORAGE_PROVIDER="s3"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Laisser vide pour AWS S3. Renseigner pour un service S3-compatible
# (ex: Supabase Storage) avec son URL d'endpoint.
S3_ENDPOINT=""

# URL publique du site (utilisee pour le SEO, les sitemaps, les donnees structurees)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
