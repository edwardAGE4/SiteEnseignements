// Schema de base de donnees - Plateforme des enseignements du Pasteur Jean-Marc GNALI
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum Status {
  DRAFT
  PUBLISHED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(EDITOR)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  teachings    Teaching[] @relation("CreatedBy")

  @@map("users")
}

model Category {
  id          String             @id @default(cuid())
  name        String             @unique
  slug        String             @unique
  description String?
  order       Int                @default(0)
  teachings   TeachingCategory[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([order])
  @@map("categories")
}

model Teaching {
  id            String             @id @default(cuid())
  title         String
  slug          String             @unique
  description   String
  youtubeUrl    String?
  spotifyUrl    String?
  coverImageUrl String?
  tags          String[]           @default([])
  status        Status             @default(DRAFT)
  publishedAt   DateTime?
  viewCount     Int                @default(0)
  downloadCount Int                @default(0)

  createdBy     User               @relation("CreatedBy", fields: [createdById], references: [id])
  createdById   String

  categories    TeachingCategory[]
  documents     TeachingDocument[]
  likes         MediaLike[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, publishedAt])
  @@index([createdById])
  @@map("teachings")
}

model TeachingCategory {
  teaching   Teaching @relation(fields: [teachingId], references: [id], onDelete: Cascade)
  teachingId String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([teachingId, categoryId])
  @@index([categoryId])
  @@map("teaching_categories")
}

// Documents PDF d'un enseignement (plusieurs par enseignement)
model TeachingDocument {
  id         String   @id @default(cuid())
  teaching   Teaching @relation(fields: [teachingId], references: [id], onDelete: Cascade)
  teachingId String
  url        String
  fileName   String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([teachingId, order])
  @@map("teaching_documents")
}

// "J'aime" anonymes sur un media d'un enseignement.
// target : "youtube", "spotify" ou "pdf:<id du document>"
// visitorId : identifiant aleatoire stocke dans un cookie du visiteur
model MediaLike {
  id         String   @id @default(cuid())
  teaching   Teaching @relation(fields: [teachingId], references: [id], onDelete: Cascade)
  teachingId String
  target     String
  visitorId  String
  createdAt  DateTime @default(now())

  @@unique([teachingId, target, visitorId])
  @@index([teachingId, target])
  @@map("media_likes")
}

// Reglages du site modifiables depuis l'admin (ex. photo du pasteur)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
